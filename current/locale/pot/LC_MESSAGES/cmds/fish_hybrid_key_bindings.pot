#: ../../../cmds/fish_hybrid_key_bindings.rst:2
msgid ""
"fish_hybrid_key_bindings - set vi key bindings for fish, with emacs bindings "
"on top"
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:5
msgid "Synopsis"
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:7
#: ../../../cmds/fish_hybrid_key_bindings.rst:25
msgid "fish_hybrid_key_bindings"
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:12
msgid "Description"
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:14
msgid ""
"``fish_hybrid_key_bindings`` enables vi-style key bindings, but keeps the "
"emacs-style bindings that don't conflict."
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:16
msgid ""
"For instance, ctrl-b and ctrl-f move the cursor back and forward one "
"character, respectively. This is a very emacs-like binding, so with the "
"usual vi-bindings it would be rmoved so fish behaves more like vi. But some "
"prefer to keep them around, so this is a quick way to do it."
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:18
msgid ""
"See also :ref:`vi mode <vi-mode>` and :doc:`fish_vi_key_bindings "
"<fish_vi_key_bindings>`."
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:21
msgid "Examples"
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:23
msgid "To start using hybrid key bindings::"
msgstr ""

#: ../../../cmds/fish_hybrid_key_bindings.rst:27
msgid ""
"or ``set -g fish_key_bindings fish_hybrid_key_bindings`` "
"in :ref:`config.fish <configuration>`."
msgstr ""
