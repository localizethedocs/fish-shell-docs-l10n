#: ../../../cmds/fish_darcs_prompt.rst:2
msgid "fish_darcs_prompt - output Darcs information for use in a prompt"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:5
msgid "Synopsis"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:7
msgid "fish_darcs_prompt"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:13
msgid ""
"function fish_prompt\n"
"     printf '%s' $PWD (fish_darcs_prompt) ' $ '\n"
"end"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:18
msgid "Description"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:20
msgid ""
"The ``fish_darcs_prompt`` function displays information about the current "
"Darcs repository, if any."
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:22
msgid "`Darcs <https://darcs.net/>`_ must be installed."
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:24
msgid ""
"The prompt always shows the VCS name (configurable via "
"``$fish_prompt_darcs_name``, default ``darcs``) as there are no branches/"
"channels; it can be unset to remove it entirely. If the repository has "
"unrecorded changes, status counts are shown for each change type:"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:26
msgid ""
"``$fish_color_darcs_normal``, default ``green`` (the prompt label color)"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:27
msgid ""
"``$fish_color_darcs_rebasing``, default ``yellow`` (used when a rebase is in "
"progress)"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:29
msgid "To match Darcs’s logo green::"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:31
msgid "set fish_color_darcs_normal 72ff01"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:33
msgid "The Darcs status symbols:"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:35
msgid "``$fish_prompt_darcs_status_added``, default ``+``"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:36
msgid "``$fish_prompt_darcs_status_modified``, default ``*``"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:37
msgid "``$fish_prompt_darcs_status_removed``, default ``-``"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:38
msgid "``$fish_prompt_darcs_status_moved``, default ``→``"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:39
msgid "``$fish_prompt_darcs_status_untracked``, default ``…``"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:40
msgid "``$fish_prompt_darcs_status_conflict``, default ``!``"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:42
msgid ""
"Colors for these symbols can be set with the corresponding variables "
"(``$fish_color_darcs_added`` & so on), which are unset by default so the "
"terminal’s foreground color is used."
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:44
msgid ""
"``$fish_prompt_darcs_status_order`` can be used to change the order the "
"status symbols appear in. It defaults to ``added removed modified moved "
"conflict untracked``."
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:46
msgid ""
"See also :doc:`fish_vcs_prompt <fish_vcs_prompt>`, which will call all "
"supported version control prompt functions, including Git, Mercurial, & "
"Darcs."
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:49
msgid "Example"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:51
msgid "A simple prompt that displays darcs info::"
msgstr ""

#: ../../../cmds/fish_darcs_prompt.rst:53
msgid ""
"function fish_prompt\n"
"    ...\n"
"    printf '%s %s$' $PWD (fish_darcs_prompt)\n"
"end"
msgstr ""
